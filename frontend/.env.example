# ShipIt Frontend Environment Configuration
# API Base URL (defaults to /api/v1 via Vite reverse proxy)
VITE_API_BASE_URL=/api/v1

# GitHub OAuth App Client ID (Required for "Continue with GitHub" button)
# Matches shipit.oauth.github.client-id in backend application.properties
VITE_GITHUB_CLIENT_ID=

# Google OAuth Client ID (Required for "Continue with Google" button)
# Matches shipit.oauth.google.client-id in backend application.properties
VITE_GOOGLE_CLIENT_ID=
